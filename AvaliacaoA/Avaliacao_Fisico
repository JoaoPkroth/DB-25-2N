CREATE TABLE Usuario (
    ID_Usuario (NUMBER(3)) PRIMARY KEY,
    Nome (STRING(250)),
    Email (STRING(250)),
    Senha (STRING(250)),
    Data_Nasc (DATE(8)),
    fk_Endereco_Endereco_PK (NUMBER(2)),
    fk_Streaming_ID_Streaming (NUMBER(3))
);

CREATE TABLE Basico (
    Pulos_Limitados STRING,
    Anuncios STRING,
    fk_Usuario_ID_Usuario (NUMBER(3)) PRIMARY KEY
);

CREATE TABLE Premium (
    Pulos_Ilimitados STRING,
    Baixar_Musicas STRING,
    Mix_Musicas STRING,
    Quantidade_Telas (STRING(2)),
    fk_Usuario_ID_Usuario (NUMBER(3)) PRIMARY KEY
);

CREATE TABLE Conteudo (
    ID_Conteudo (NUMBER(3)) PRIMARY KEY,
    Nome (STRING(250)),
    Data_Lancamento (DATE(8)),
    Tipo (STRING(250)),
    fk_Streaming_ID_Streaming (NUMBER(3)),
    fk_Artista_ID_Artista (NUMBER(3))
);

CREATE TABLE Playlist (
